# Copy to `.env` at the repository root and fill in. Never commit `.env`, and
# never put real credentials in this template — it is not gitignored.

# --- Language model: Azure OpenAI (required for real runs) ---
AZURE_API_KEY=
AZURE_API_BASE=https://<your-resource>.openai.azure.com
AZURE_API_VERSION=2024-05-01-preview

# Deployment name to use. Accepts a bare name (`gpt-4.1-kasia`) or a
# LiteLLM-style prefixed name (`azure/gpt-4.1-kasia`); the prefix is stripped.
# Resolution order: `--model` > `llm.deployment` in the config > this variable
# > the built-in default (gpt-4.1-kasia).
LLM_MODEL=gpt-4.1-kasia

# --- Semantic Scholar ---
# Strongly recommended: the unauthenticated shared pool is aggressively rate
# limited and typically returns HTTP 429 for every request from a server IP.
# Request a key at https://www.semanticscholar.org/product/api#api-key-form
S2_API_KEY=

# --- Crossref ---
# Optional contact address for the Crossref "polite pool" (better rate limits).
CROSSREF_MAILTO=
